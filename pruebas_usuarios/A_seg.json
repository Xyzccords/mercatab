[{"id": 0, "seek": 0, "start": 0.0, "end": 3.0, "text": " Buenas tardes, señora Mari.", "tokens": [50364, 4078, 11581, 21057, 279, 11, 41094, 34478, 13, 50514], "temperature": 0.0, "avg_logprob": -0.23257536046645222, "compression_ratio": 1.5972222222222223, "no_speech_prob": 0.5801459550857544}, {"id": 1, "seek": 0, "start": 3.0, "end": 7.0, "text": " Le comento que estamos haciendo pruebas de un sistema.", "tokens": [50514, 1456, 14541, 78, 631, 10382, 20509, 32820, 16342, 368, 517, 13245, 13, 50714], "temperature": 0.0, "avg_logprob": -0.23257536046645222, "compression_ratio": 1.5972222222222223, "no_speech_prob": 0.5801459550857544}, {"id": 2, "seek": 0, "start": 7.0, "end": 12.0, "text": " Le voy a hacer unas pruebas, pero no a usted, sino a alguien enfocado en el sistema.", "tokens": [50714, 1456, 7552, 257, 6720, 25405, 32820, 16342, 11, 4768, 572, 257, 10467, 11, 18108, 257, 25814, 10667, 905, 1573, 465, 806, 13245, 13, 50964], "temperature": 0.0, "avg_logprob": -0.23257536046645222, "compression_ratio": 1.5972222222222223, "no_speech_prob": 0.5801459550857544}, {"id": 3, "seek": 0, "start": 12.0, "end": 14.0, "text": " No se le va a probar a usted.", "tokens": [50964, 883, 369, 476, 2773, 257, 1239, 289, 257, 10467, 13, 51064], "temperature": 0.0, "avg_logprob": -0.23257536046645222, "compression_ratio": 1.5972222222222223, "no_speech_prob": 0.5801459550857544}, {"id": 4, "seek": 0, "start": 14.0, "end": 21.0, "text": " Pero antes de continuar, le voy a tomar su consentimiento, si usted está de acuerdo o no, para continuar la prueba.", "tokens": [51064, 9377, 11014, 368, 29980, 11, 476, 7552, 257, 22048, 459, 14546, 14007, 11, 1511, 10467, 3192, 368, 28113, 277, 572, 11, 1690, 29980, 635, 48241, 13, 51414], "temperature": 0.0, "avg_logprob": -0.23257536046645222, "compression_ratio": 1.5972222222222223, "no_speech_prob": 0.5801459550857544}, {"id": 5, "seek": 0, "start": 21.0, "end": 22.0, "text": " Sí.", "tokens": [51414, 12375, 13, 51464], "temperature": 0.0, "avg_logprob": -0.23257536046645222, "compression_ratio": 1.5972222222222223, "no_speech_prob": 0.5801459550857544}, {"id": 6, "seek": 0, "start": 22.0, "end": 24.0, "text": " Ahora vamos a continuar.", "tokens": [51464, 18840, 5295, 257, 29980, 13, 51564], "temperature": 0.0, "avg_logprob": -0.23257536046645222, "compression_ratio": 1.5972222222222223, "no_speech_prob": 0.5801459550857544}, {"id": 7, "seek": 2400, "start": 24.0, "end": 29.0, "text": " Le voy a pedir algunos datos, por ejemplo, ¿cuál es su edad?", "tokens": [50364, 1456, 7552, 257, 33533, 21078, 27721, 11, 1515, 13358, 11, 3841, 12032, 11447, 785, 459, 1257, 345, 30, 50614], "temperature": 0.0, "avg_logprob": -0.3130282151071649, "compression_ratio": 1.3636363636363635, "no_speech_prob": 0.706847608089447}, {"id": 8, "seek": 2400, "start": 29.0, "end": 31.0, "text": " Me comento, por favor.", "tokens": [50614, 1923, 14541, 78, 11, 1515, 2294, 13, 50714], "temperature": 0.0, "avg_logprob": -0.3130282151071649, "compression_ratio": 1.3636363636363635, "no_speech_prob": 0.706847608089447}, {"id": 9, "seek": 2400, "start": 31.0, "end": 33.0, "text": " Hola, tengo 40 años.", "tokens": [50714, 22637, 11, 13989, 3356, 11424, 13, 50814], "temperature": 0.0, "avg_logprob": -0.3130282151071649, "compression_ratio": 1.3636363636363635, "no_speech_prob": 0.706847608089447}, {"id": 10, "seek": 2400, "start": 33.0, "end": 35.0, "text": " ¿Su ocupación en relación con el negocio?", "tokens": [50814, 3841, 46413, 37305, 3482, 465, 37247, 416, 806, 26722, 8529, 30, 50914], "temperature": 0.0, "avg_logprob": -0.3130282151071649, "compression_ratio": 1.3636363636363635, "no_speech_prob": 0.706847608089447}, {"id": 11, "seek": 2400, "start": 35.0, "end": 39.0, "text": " Soy a Madi Casa, pero no tengo mi nexor propio de abajo.", "tokens": [50914, 24758, 257, 5326, 72, 44843, 11, 4768, 572, 13989, 2752, 408, 87, 284, 40098, 368, 30613, 13, 51114], "temperature": 0.0, "avg_logprob": -0.3130282151071649, "compression_ratio": 1.3636363636363635, "no_speech_prob": 0.706847608089447}, {"id": 12, "seek": 2400, "start": 39.0, "end": 45.0, "text": " Y veo que está en un dispositivo y que está con el navegador Chrome.", "tokens": [51114, 398, 41319, 631, 3192, 465, 517, 34769, 6340, 288, 631, 3192, 416, 806, 39376, 70, 5409, 15327, 13, 51414], "temperature": 0.0, "avg_logprob": -0.3130282151071649, "compression_ratio": 1.3636363636363635, "no_speech_prob": 0.706847608089447}, {"id": 13, "seek": 2400, "start": 45.0, "end": 46.0, "text": " Sí.", "tokens": [51414, 12375, 13, 51464], "temperature": 0.0, "avg_logprob": -0.3130282151071649, "compression_ratio": 1.3636363636363635, "no_speech_prob": 0.706847608089447}, {"id": 14, "seek": 4600, "start": 47.0, "end": 52.0, "text": " Ahora vamos a pasar o le voy a indicar que usted va a hacer una tarea,", "tokens": [50414, 18840, 5295, 257, 25344, 277, 476, 7552, 257, 4694, 289, 631, 10467, 2773, 257, 6720, 2002, 256, 35425, 11, 50664], "temperature": 0.0, "avg_logprob": -0.1389332115650177, "compression_ratio": 1.5951219512195123, "no_speech_prob": 0.28035756945610046}, {"id": 15, "seek": 4600, "start": 52.0, "end": 57.0, "text": " la que consiste en que usted tiene un producto, un puesto de agarrotes,", "tokens": [50664, 635, 631, 49066, 465, 631, 10467, 7066, 517, 47583, 11, 517, 35136, 368, 623, 2284, 17251, 11, 50914], "temperature": 0.0, "avg_logprob": -0.1389332115650177, "compression_ratio": 1.5951219512195123, "no_speech_prob": 0.28035756945610046}, {"id": 16, "seek": 4600, "start": 57.0, "end": 64.0, "text": " y un cliente le compró productos y necesita registrar la venta y usted luego ver sus ganancias de la venta.", "tokens": [50914, 288, 517, 6423, 68, 476, 715, 11721, 46363, 288, 45485, 11376, 5352, 635, 6931, 64, 288, 10467, 17222, 1306, 3291, 7574, 282, 12046, 368, 635, 6931, 64, 13, 51264], "temperature": 0.0, "avg_logprob": -0.1389332115650177, "compression_ratio": 1.5951219512195123, "no_speech_prob": 0.28035756945610046}, {"id": 17, "seek": 4600, "start": 64.0, "end": 67.0, "text": " Le voy a contar hasta tres para que empiece.", "tokens": [51264, 1456, 7552, 257, 27045, 10764, 15890, 1690, 631, 4012, 46566, 13, 51414], "temperature": 0.0, "avg_logprob": -0.1389332115650177, "compression_ratio": 1.5951219512195123, "no_speech_prob": 0.28035756945610046}, {"id": 18, "seek": 4600, "start": 67.0, "end": 70.0, "text": " Uno, dos, tres, puede empezar.", "tokens": [51414, 37468, 11, 4491, 11, 15890, 11, 8919, 31168, 13, 51564], "temperature": 0.0, "avg_logprob": -0.1389332115650177, "compression_ratio": 1.5951219512195123, "no_speech_prob": 0.28035756945610046}, {"id": 19, "seek": 7000, "start": 70.0, "end": 79.0, "text": " Voy a registrar la venta de mi producto que me han solicitado y también veo la cantidad con esto.", "tokens": [50364, 25563, 257, 11376, 5352, 635, 6931, 64, 368, 2752, 47583, 631, 385, 7276, 23665, 270, 1573, 288, 6407, 41319, 635, 33757, 416, 7433, 13, 50814], "temperature": 0.0, "avg_logprob": -0.2610141875896048, "compression_ratio": 1.5634517766497462, "no_speech_prob": 0.2925029993057251}, {"id": 20, "seek": 7000, "start": 79.0, "end": 89.0, "text": " Aceptar y aquí me sale la venta, lo he registrado, no hagan ansias, que es 181.", "tokens": [50814, 316, 1336, 289, 288, 6661, 385, 8680, 635, 6931, 64, 11, 450, 415, 11376, 14974, 11, 572, 324, 1275, 1567, 4609, 11, 631, 785, 2443, 16, 13, 51314], "temperature": 0.0, "avg_logprob": -0.2610141875896048, "compression_ratio": 1.5634517766497462, "no_speech_prob": 0.2925029993057251}, {"id": 21, "seek": 7000, "start": 89.0, "end": 98.0, "text": " Y también me ayuda también el que es semanal o mensual y también a que por la fecha, por mes hasta el día 5, el día de hoy.", "tokens": [51314, 398, 6407, 385, 30737, 6407, 806, 631, 785, 369, 1601, 304, 277, 10923, 901, 288, 6407, 257, 631, 1515, 635, 579, 4413, 11, 1515, 3813, 10764, 806, 12271, 1025, 11, 806, 12271, 368, 13775, 13, 51764], "temperature": 0.0, "avg_logprob": -0.2610141875896048, "compression_ratio": 1.5634517766497462, "no_speech_prob": 0.2925029993057251}, {"id": 22, "seek": 9800, "start": 99.0, "end": 102.0, "text": " Y esto es mi ganancia de 93.90.", "tokens": [50414, 398, 7433, 785, 2752, 7574, 22862, 368, 28876, 13, 7771, 13, 50564], "temperature": 0.0, "avg_logprob": -0.12675689248477712, "compression_ratio": 1.5547445255474452, "no_speech_prob": 0.07453753799200058}, {"id": 23, "seek": 9800, "start": 102.0, "end": 105.0, "text": " Ya señor, hasta acá sería la prueba del día de hoy.", "tokens": [50564, 6080, 22188, 11, 10764, 23496, 23679, 635, 48241, 1103, 12271, 368, 13775, 13, 50714], "temperature": 0.0, "avg_logprob": -0.12675689248477712, "compression_ratio": 1.5547445255474452, "no_speech_prob": 0.07453753799200058}, {"id": 24, "seek": 9800, "start": 105.0, "end": 109.0, "text": " Ahora le voy a decir que usted es libre de explorar el sistema o la aplicación", "tokens": [50714, 18840, 476, 7552, 257, 10235, 631, 10467, 785, 29976, 368, 24765, 289, 806, 13245, 277, 635, 18221, 3482, 50914], "temperature": 0.0, "avg_logprob": -0.12675689248477712, "compression_ratio": 1.5547445255474452, "no_speech_prob": 0.07453753799200058}, {"id": 25, "seek": 9800, "start": 109.0, "end": 112.0, "text": " y me puede comentar si tiene alguna observación para anotar.", "tokens": [50914, 288, 385, 8919, 14541, 289, 1511, 7066, 20651, 9951, 3482, 1690, 364, 310, 289, 13, 51064], "temperature": 0.0, "avg_logprob": -0.12675689248477712, "compression_ratio": 1.5547445255474452, "no_speech_prob": 0.07453753799200058}, {"id": 26, "seek": 9800, "start": 112.0, "end": 119.0, "text": " Bueno, esto para mí es mucho más fácil, me ayuda a ver tantos productos de cantidad", "tokens": [51064, 16046, 11, 7433, 1690, 14692, 785, 9824, 3573, 17474, 11, 385, 30737, 257, 1306, 12095, 329, 46363, 368, 33757, 51414], "temperature": 0.0, "avg_logprob": -0.12675689248477712, "compression_ratio": 1.5547445255474452, "no_speech_prob": 0.07453753799200058}, {"id": 27, "seek": 9800, "start": 119.0, "end": 127.0, "text": " y también me ayuda a ver las ventas más rápidas y las ganancias que tengo tanto mensual, diario y semanal.", "tokens": [51414, 288, 6407, 385, 30737, 257, 1306, 2439, 6931, 296, 3573, 18213, 11382, 288, 2439, 7574, 282, 12046, 631, 13989, 10331, 10923, 901, 11, 1026, 4912, 288, 369, 1601, 304, 13, 51814], "temperature": 0.0, "avg_logprob": -0.12675689248477712, "compression_ratio": 1.5547445255474452, "no_speech_prob": 0.07453753799200058}, {"id": 28, "seek": 12800, "start": 129.0, "end": 140.0, "text": " Ya, esto habiendo explorado usted todo el sistema, ahora me va a decir o le voy a decir una serie de tres preguntas para continuar con el registro.", "tokens": [50414, 6080, 11, 7433, 3025, 7304, 24765, 1573, 10467, 5149, 806, 13245, 11, 9923, 385, 2773, 257, 10235, 277, 476, 7552, 257, 10235, 2002, 23030, 368, 15890, 39722, 1690, 29980, 416, 806, 11376, 340, 13, 50964], "temperature": 0.0, "avg_logprob": -0.23568294894310735, "compression_ratio": 1.6116071428571428, "no_speech_prob": 0.05814982205629349}, {"id": 29, "seek": 12800, "start": 140.0, "end": 145.0, "text": " Primera pregunta sería esto, que fue lo más difícil que le pareció a usted.", "tokens": [50964, 19671, 1663, 24252, 23679, 7433, 11, 631, 9248, 450, 3573, 17258, 631, 476, 7448, 19609, 257, 10467, 13, 51214], "temperature": 0.0, "avg_logprob": -0.23568294894310735, "compression_ratio": 1.6116071428571428, "no_speech_prob": 0.05814982205629349}, {"id": 30, "seek": 12800, "start": 145.0, "end": 149.0, "text": " No, esto es bien, para mí me ayuda bastante, está entendible.", "tokens": [51214, 883, 11, 7433, 785, 3610, 11, 1690, 14692, 385, 30737, 14651, 11, 3192, 16612, 964, 13, 51414], "temperature": 0.0, "avg_logprob": -0.23568294894310735, "compression_ratio": 1.6116071428571428, "no_speech_prob": 0.05814982205629349}, {"id": 31, "seek": 12800, "start": 149.0, "end": 155.0, "text": " Ya, ahora la segunda pregunta es que usted cambiaría la aplicación.", "tokens": [51414, 6080, 11, 9923, 635, 21978, 24252, 785, 631, 10467, 19569, 21178, 635, 18221, 3482, 13, 51714], "temperature": 0.0, "avg_logprob": -0.23568294894310735, "compression_ratio": 1.6116071428571428, "no_speech_prob": 0.05814982205629349}, {"id": 32, "seek": 15500, "start": 155.0, "end": 157.0, "text": " No, no, no.", "tokens": [50364, 883, 11, 572, 11, 572, 13, 50464], "temperature": 0.2, "avg_logprob": -0.3113753318786621, "compression_ratio": 1.4907407407407407, "no_speech_prob": 0.14175087213516235}, {"id": 33, "seek": 15500, "start": 157.0, "end": 159.0, "text": " No, no es entendible.", "tokens": [50464, 883, 11, 572, 785, 16612, 964, 13, 50564], "temperature": 0.2, "avg_logprob": -0.3113753318786621, "compression_ratio": 1.4907407407407407, "no_speech_prob": 0.14175087213516235}, {"id": 34, "seek": 15500, "start": 159.0, "end": 160.0, "text": " Ah, ok.", "tokens": [50564, 2438, 11, 3133, 13, 50614], "temperature": 0.2, "avg_logprob": -0.3113753318786621, "compression_ratio": 1.4907407407407407, "no_speech_prob": 0.14175087213516235}, {"id": 35, "seek": 15500, "start": 160.0, "end": 169.0, "text": " La última sería usted, confiaría en el sistema para su negocio o la aplicación para su negocio.", "tokens": [50614, 2369, 28118, 23679, 10467, 11, 1497, 9448, 2686, 465, 806, 13245, 1690, 459, 26722, 8529, 277, 635, 18221, 3482, 1690, 459, 26722, 8529, 13, 51064], "temperature": 0.2, "avg_logprob": -0.3113753318786621, "compression_ratio": 1.4907407407407407, "no_speech_prob": 0.14175087213516235}, {"id": 36, "seek": 15500, "start": 169.0, "end": 176.0, "text": " Sí, claro que sí, es algo positivo que nos ayuda, gana más tiempo y es positivo, nos ayuda bastante.", "tokens": [51064, 12375, 11, 16742, 631, 8600, 11, 785, 8655, 44710, 631, 3269, 30737, 11, 290, 2095, 3573, 11772, 288, 785, 44710, 11, 3269, 30737, 14651, 13, 51414], "temperature": 0.2, "avg_logprob": -0.3113753318786621, "compression_ratio": 1.4907407407407407, "no_speech_prob": 0.14175087213516235}, {"id": 37, "seek": 15500, "start": 176.0, "end": 181.0, "text": " Ya. Bueno, eso sería todo señora Mari, muchas gracias por su tiempo.", "tokens": [51414, 6080, 13, 16046, 11, 7287, 23679, 5149, 41094, 34478, 11, 16072, 16611, 1515, 459, 11772, 13, 51664], "temperature": 0.2, "avg_logprob": -0.3113753318786621, "compression_ratio": 1.4907407407407407, "no_speech_prob": 0.14175087213516235}, {"id": 38, "seek": 15500, "start": 182.0, "end": 183.0, "text": " Chao.", "tokens": [51714, 12374, 78, 13, 51764], "temperature": 0.2, "avg_logprob": -0.3113753318786621, "compression_ratio": 1.4907407407407407, "no_speech_prob": 0.14175087213516235}]