[{"id": 0, "seek": 0, "start": 0.0, "end": 10.0, "text": " ¿Qué tal? Buenas tardes. Esto nos encontramos aquí con Jonathan, que es una estudiante de la universidad.", "tokens": [50364, 3841, 15137, 4023, 30, 4078, 11581, 21057, 279, 13, 20880, 3269, 45049, 6661, 416, 15471, 11, 631, 785, 2002, 13542, 72, 2879, 368, 635, 5950, 4580, 13, 50864], "temperature": 0.0, "avg_logprob": -0.26163318340594954, "compression_ratio": 1.4, "no_speech_prob": 0.5717244744300842}, {"id": 1, "seek": 0, "start": 10.0, "end": 22.0, "text": " En primer lugar le voy a presentar esto. Es una persona con una discapacidad auditiva y vamos a hacer esto de la prueba con ella.", "tokens": [50864, 2193, 12595, 11467, 476, 7552, 257, 1974, 289, 7433, 13, 2313, 2002, 12184, 416, 2002, 717, 9485, 326, 4580, 17748, 5931, 288, 5295, 257, 6720, 7433, 368, 635, 48241, 416, 18823, 13, 51464], "temperature": 0.0, "avg_logprob": -0.26163318340594954, "compression_ratio": 1.4, "no_speech_prob": 0.5717244744300842}, {"id": 2, "seek": 2200, "start": 23.0, "end": 33.0, "text": " Ahora, pero antes de esto le tengo que decir que estamos probando el sistema, pero a ti no.", "tokens": [50414, 18840, 11, 4768, 11014, 368, 7433, 476, 13989, 631, 10235, 631, 10382, 1239, 1806, 806, 13245, 11, 4768, 257, 8757, 572, 13, 50914], "temperature": 0.0, "avg_logprob": -0.22816868104796478, "compression_ratio": 1.4294117647058824, "no_speech_prob": 0.4206492602825165}, {"id": 3, "seek": 2200, "start": 33.0, "end": 40.0, "text": " Y después también tengo que decirle que debo tener su consentimiento, pero continuar con esa prueba. ¿Usted estará de acuerdo?", "tokens": [50914, 398, 15283, 6407, 13989, 631, 10235, 306, 631, 368, 1763, 11640, 459, 14546, 14007, 11, 4768, 29980, 416, 11342, 48241, 13, 3841, 52, 30115, 8755, 842, 368, 28113, 30, 51264], "temperature": 0.0, "avg_logprob": -0.22816868104796478, "compression_ratio": 1.4294117647058824, "no_speech_prob": 0.4206492602825165}, {"id": 4, "seek": 2200, "start": 41.0, "end": 42.0, "text": " Sí, normal.", "tokens": [51314, 12375, 11, 2710, 13, 51364], "temperature": 0.0, "avg_logprob": -0.22816868104796478, "compression_ratio": 1.4294117647058824, "no_speech_prob": 0.4206492602825165}, {"id": 5, "seek": 2200, "start": 42.0, "end": 43.0, "text": " Ya, ok.", "tokens": [51364, 6080, 11, 3133, 13, 51414], "temperature": 0.0, "avg_logprob": -0.22816868104796478, "compression_ratio": 1.4294117647058824, "no_speech_prob": 0.4206492602825165}, {"id": 6, "seek": 4300, "start": 43.0, "end": 44.0, "text": " Ya, ok.", "tokens": [50364, 6080, 11, 3133, 13, 50414], "temperature": 0.0, "avg_logprob": -0.2034044394621978, "compression_ratio": 1.2721518987341771, "no_speech_prob": 0.4512994885444641}, {"id": 7, "seek": 4300, "start": 46.0, "end": 56.0, "text": " Ahora, pero antes de todo esto, le voy a pedir que me regales su edad. ¿Cuántos años tiene? ¿22?", "tokens": [50514, 18840, 11, 4768, 11014, 368, 5149, 7433, 11, 476, 7552, 257, 33533, 631, 385, 1121, 4229, 459, 1257, 345, 13, 3841, 35222, 27525, 329, 11424, 7066, 30, 3841, 7490, 30, 51014], "temperature": 0.0, "avg_logprob": -0.2034044394621978, "compression_ratio": 1.2721518987341771, "no_speech_prob": 0.4512994885444641}, {"id": 8, "seek": 4300, "start": 56.0, "end": 59.0, "text": " Bueno, 22 sí.", "tokens": [51014, 16046, 11, 5853, 8600, 13, 51164], "temperature": 0.0, "avg_logprob": -0.2034044394621978, "compression_ratio": 1.2721518987341771, "no_speech_prob": 0.4512994885444641}, {"id": 9, "seek": 4300, "start": 59.0, "end": 60.0, "text": " Ah, ok.", "tokens": [51164, 2438, 11, 3133, 13, 51214], "temperature": 0.0, "avg_logprob": -0.2034044394621978, "compression_ratio": 1.2721518987341771, "no_speech_prob": 0.4512994885444641}, {"id": 10, "seek": 4300, "start": 62.0, "end": 68.0, "text": " Ya, esto, su ocupación y su relación con el negocio ¿cuál sería?", "tokens": [51314, 6080, 11, 7433, 11, 459, 37305, 3482, 288, 459, 37247, 416, 806, 26722, 8529, 3841, 12032, 11447, 23679, 30, 51614], "temperature": 0.0, "avg_logprob": -0.2034044394621978, "compression_ratio": 1.2721518987341771, "no_speech_prob": 0.4512994885444641}, {"id": 11, "seek": 6800, "start": 69.0, "end": 74.0, "text": " Bueno, soy estudiante y tengo mi pequeño negocio de aparte.", "tokens": [50414, 16046, 11, 8812, 13542, 72, 2879, 288, 13989, 2752, 38181, 26722, 8529, 368, 4936, 68, 13, 50664], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 12, "seek": 6800, "start": 74.0, "end": 75.0, "text": " Ya, ok.", "tokens": [50664, 6080, 11, 3133, 13, 50714], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 13, "seek": 6800, "start": 76.0, "end": 77.0, "text": " Ok, está bien.", "tokens": [50764, 3477, 11, 3192, 3610, 13, 50814], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 14, "seek": 6800, "start": 78.0, "end": 79.0, "text": " Ya.", "tokens": [50864, 6080, 13, 50914], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 15, "seek": 6800, "start": 82.0, "end": 83.0, "text": " Seguimos.", "tokens": [51064, 1100, 2794, 8372, 13, 51114], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 16, "seek": 6800, "start": 84.0, "end": 88.0, "text": " Ahora, ¿con qué dispositivo se encuentra? Con una laptop, me comentó.", "tokens": [51164, 18840, 11, 3841, 1671, 8057, 34769, 6340, 369, 43274, 30, 2656, 2002, 10732, 11, 385, 14541, 812, 13, 51364], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 17, "seek": 6800, "start": 88.0, "end": 89.0, "text": " ¿Cómo dijo?", "tokens": [51364, 3841, 28342, 27024, 30, 51414], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 18, "seek": 6800, "start": 89.0, "end": 91.0, "text": " ¿Con qué dispositivo se encuentra?", "tokens": [51414, 3841, 9838, 8057, 34769, 6340, 369, 43274, 30, 51514], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 19, "seek": 6800, "start": 92.0, "end": 94.0, "text": " Sí, estoy con una laptop.", "tokens": [51564, 12375, 11, 15796, 416, 2002, 10732, 13, 51664], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 20, "seek": 6800, "start": 94.0, "end": 95.0, "text": " Ok, ok.", "tokens": [51664, 3477, 11, 3133, 13, 51714], "temperature": 0.0, "avg_logprob": -0.17219876228494846, "compression_ratio": 1.4438202247191012, "no_speech_prob": 0.04393007978796959}, {"id": 21, "seek": 9500, "start": 95.0, "end": 97.0, "text": " Ya, y el navegador es Chrome, ¿no?", "tokens": [50364, 6080, 11, 288, 806, 39376, 70, 5409, 785, 15327, 11, 3841, 1771, 30, 50464], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 22, "seek": 9500, "start": 97.0, "end": 99.0, "text": " Sí, por lo que veo sí.", "tokens": [50464, 12375, 11, 1515, 450, 631, 41319, 8600, 13, 50564], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 23, "seek": 9500, "start": 99.0, "end": 101.0, "text": " Sí, sí.", "tokens": [50564, 12375, 11, 8600, 13, 50664], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 24, "seek": 9500, "start": 105.0, "end": 106.0, "text": " Ya.", "tokens": [50864, 6080, 13, 50914], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 25, "seek": 9500, "start": 107.0, "end": 108.0, "text": " Ahora sí.", "tokens": [50964, 18840, 8600, 13, 51014], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 26, "seek": 9500, "start": 110.0, "end": 113.0, "text": " Esto, vamos a pasar con la tarea principal.", "tokens": [51114, 20880, 11, 5295, 257, 25344, 416, 635, 256, 35425, 9716, 13, 51264], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 27, "seek": 9500, "start": 113.0, "end": 121.0, "text": " Estoy, pero ante todo esto yo le he pasado una imagen, si es que usted no me logró escuchar muy bien, para que lea la tarea y la puede ejecutar.", "tokens": [51264, 49651, 11, 4768, 23411, 5149, 7433, 5290, 476, 415, 24794, 2002, 40652, 11, 1511, 785, 631, 10467, 572, 385, 31013, 812, 22483, 289, 5323, 3610, 11, 1690, 631, 476, 64, 635, 256, 35425, 288, 635, 8919, 39564, 6672, 289, 13, 51664], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 28, "seek": 9500, "start": 121.0, "end": 124.0, "text": " Pero en todo caso le voy a lear la tarea.", "tokens": [51664, 9377, 465, 5149, 9666, 476, 7552, 257, 476, 289, 635, 256, 35425, 13, 51814], "temperature": 0.0, "avg_logprob": -0.1998974052635399, "compression_ratio": 1.488262910798122, "no_speech_prob": 0.014050302095711231}, {"id": 29, "seek": 12500, "start": 125.0, "end": 134.0, "text": " Aquí consiste la tarea, es que usted tiene un puesto de abarrotes y un cliente compró productos y necesita registrar la venta y luego ver tu ganancia.", "tokens": [50364, 24386, 49066, 635, 256, 35425, 11, 785, 631, 10467, 7066, 517, 35136, 368, 410, 2284, 17251, 288, 517, 6423, 68, 715, 11721, 46363, 288, 45485, 11376, 5352, 635, 6931, 64, 288, 17222, 1306, 2604, 7574, 22862, 13, 50814], "temperature": 0.0, "avg_logprob": -0.1579330840913376, "compression_ratio": 1.5806451612903225, "no_speech_prob": 0.0625925064086914}, {"id": 30, "seek": 12500, "start": 134.0, "end": 139.0, "text": " Le voy a decir que esto va a ser sin ayuda y después me comenta lo que piensa.", "tokens": [50814, 1456, 7552, 257, 10235, 631, 7433, 2773, 257, 816, 3343, 30737, 288, 15283, 385, 395, 8938, 450, 631, 3895, 23364, 13, 51064], "temperature": 0.0, "avg_logprob": -0.1579330840913376, "compression_ratio": 1.5806451612903225, "no_speech_prob": 0.0625925064086914}, {"id": 31, "seek": 12500, "start": 139.0, "end": 145.0, "text": " Le voy a contar, le voy a hacer una cuenta de tres para que empiece, hacer la prueba.", "tokens": [51064, 1456, 7552, 257, 27045, 11, 476, 7552, 257, 6720, 2002, 17868, 368, 15890, 1690, 631, 4012, 46566, 11, 6720, 635, 48241, 13, 51364], "temperature": 0.0, "avg_logprob": -0.1579330840913376, "compression_ratio": 1.5806451612903225, "no_speech_prob": 0.0625925064086914}, {"id": 32, "seek": 12500, "start": 145.0, "end": 148.0, "text": " Uno, dos, tres.", "tokens": [51364, 37468, 11, 4491, 11, 15890, 13, 51514], "temperature": 0.0, "avg_logprob": -0.1579330840913376, "compression_ratio": 1.5806451612903225, "no_speech_prob": 0.0625925064086914}, {"id": 33, "seek": 12500, "start": 148.0, "end": 149.0, "text": " Empiece.", "tokens": [51514, 8599, 46566, 13, 51564], "temperature": 0.0, "avg_logprob": -0.1579330840913376, "compression_ratio": 1.5806451612903225, "no_speech_prob": 0.0625925064086914}, {"id": 34, "seek": 14900, "start": 149.0, "end": 151.0, "text": " Ventas.", "tokens": [50364, 28290, 296, 13, 50464], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 35, "seek": 14900, "start": 152.0, "end": 155.0, "text": " Ok, esto no nos da la venta.", "tokens": [50514, 3477, 11, 7433, 572, 3269, 1120, 635, 6931, 64, 13, 50664], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 36, "seek": 14900, "start": 155.0, "end": 158.0, "text": " Produtos tenemos, van a azúcar.", "tokens": [50664, 1705, 67, 34640, 9914, 11, 3161, 257, 7883, 37774, 13, 50814], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 37, "seek": 14900, "start": 159.0, "end": 161.0, "text": " Cantio dos.", "tokens": [50864, 26697, 1004, 4491, 13, 50964], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 38, "seek": 14900, "start": 162.0, "end": 163.0, "text": " Guardar.", "tokens": [51014, 11549, 289, 13, 51064], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 39, "seek": 14900, "start": 165.0, "end": 167.0, "text": " A ver, con nosotros.", "tokens": [51164, 316, 1306, 11, 416, 13863, 13, 51264], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 40, "seek": 14900, "start": 168.0, "end": 169.0, "text": " Leche.", "tokens": [51314, 1456, 1876, 13, 51364], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 41, "seek": 14900, "start": 172.0, "end": 173.0, "text": " Guardar.", "tokens": [51514, 11549, 289, 13, 51564], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ratio": 1.2, "no_speech_prob": 0.273851215839386}, {"id": 42, "seek": 14900, "start": 175.0, "end": 177.0, "text": " Ganancias.", "tokens": [51664, 19461, 282, 12046, 13, 51764], "temperature": 0.0, "avg_logprob": -0.3963589812770034, "compression_ra