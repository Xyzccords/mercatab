[{"id": 0, "seek": 0, "start": 0.0, "end": 8.0, "text": " Y eso, buenos días, esto como de verdad es ahora vamos a hacer la prueba del sistema, pero antes", "tokens": [50364, 398, 7287, 11, 49617, 19527, 11, 7433, 2617, 368, 13692, 785, 9923, 5295, 257, 6720, 635, 48241, 1103, 13245, 11, 4768, 11014, 50764], "temperature": 0.0, "avg_logprob": -0.4667879901354826, "compression_ratio": 1.574585635359116, "no_speech_prob": 0.4429955780506134}, {"id": 1, "seek": 0, "start": 8.0, "end": 15.0, "text": " esto quiero pedirle su consejimiento, ¿no? Esto, usted va a participar de esto en una prueba", "tokens": [50764, 7433, 16811, 33533, 306, 459, 4425, 73, 14007, 11, 3841, 1771, 30, 20880, 11, 10467, 2773, 257, 48703, 368, 7433, 465, 2002, 48241, 51114], "temperature": 0.0, "avg_logprob": -0.4667879901354826, "compression_ratio": 1.574585635359116, "no_speech_prob": 0.4429955780506134}, {"id": 2, "seek": 0, "start": 15.0, "end": 23.0, "text": " para un sistema de aloja de pelo, esto que estamos promoviendo, entiendo que no se va a volar", "tokens": [51114, 1690, 517, 13245, 368, 419, 78, 2938, 368, 12167, 11, 7433, 631, 10382, 2234, 5179, 7304, 11, 948, 7304, 631, 572, 369, 2773, 257, 1996, 289, 51514], "temperature": 0.0, "avg_logprob": -0.4667879901354826, "compression_ratio": 1.574585635359116, "no_speech_prob": 0.4429955780506134}, {"id": 3, "seek": 2300, "start": 24.0, "end": 29.0, "text": " esto a usted sino más bien al sistema, ¿está de acuerdo con hacer esta prueba?", "tokens": [50414, 7433, 257, 10467, 18108, 3573, 3610, 419, 13245, 11, 3841, 377, 842, 368, 28113, 416, 6720, 5283, 48241, 30, 50664], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 4, "seek": 2300, "start": 30.0, "end": 31.0, "text": " Sí, estoy de acuerdo.", "tokens": [50714, 12375, 11, 15796, 368, 28113, 13, 50764], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 5, "seek": 2300, "start": 31.0, "end": 36.0, "text": " Ya, ok, ahora vamos a empezar, le voy a tomar algunos datos para empezar a hacer la prueba.", "tokens": [50764, 6080, 11, 3133, 11, 9923, 5295, 257, 31168, 11, 476, 7552, 257, 22048, 21078, 27721, 1690, 31168, 257, 6720, 635, 48241, 13, 51014], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 6, "seek": 2300, "start": 36.0, "end": 39.0, "text": " Ya, esto ¿cuál es su edad, me permite?", "tokens": [51014, 6080, 11, 7433, 3841, 12032, 11447, 785, 459, 1257, 345, 11, 385, 31105, 30, 51164], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 7, "seek": 2300, "start": 40.0, "end": 41.0, "text": " 22 años.", "tokens": [51214, 5853, 11424, 13, 51264], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 8, "seek": 2300, "start": 41.0, "end": 43.0, "text": " Ok, esto es su ocupación.", "tokens": [51264, 3477, 11, 7433, 785, 459, 37305, 3482, 13, 51364], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 9, "seek": 2300, "start": 44.0, "end": 45.0, "text": " E Ingenieros sistemas.", "tokens": [51414, 462, 682, 1766, 811, 329, 48720, 13, 51464], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 10, "seek": 2300, "start": 45.0, "end": 48.0, "text": " Esto, su negocio es propio, ¿no? Como se me dijo.", "tokens": [51464, 20880, 11, 459, 26722, 8529, 785, 40098, 11, 3841, 1771, 30, 11913, 369, 385, 27024, 13, 51614], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 11, "seek": 2300, "start": 48.0, "end": 50.0, "text": " Ah, sí, también, en una bodega.", "tokens": [51614, 2438, 11, 8600, 11, 6407, 11, 465, 2002, 16737, 6335, 13, 51714], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 12, "seek": 2300, "start": 50.0, "end": 51.0, "text": " Ya.", "tokens": [51714, 6080, 13, 51764], "temperature": 0.0, "avg_logprob": -0.26282298748309796, "compression_ratio": 1.4846153846153847, "no_speech_prob": 0.7724218368530273}, {"id": 13, "seek": 5100, "start": 51.0, "end": 59.0, "text": " Mira, ahora sí, vamos a pasar a la prueba, ¿no?", "tokens": [50364, 28394, 11, 9923, 8600, 11, 5295, 257, 25344, 257, 635, 48241, 11, 3841, 1771, 30, 50764], "temperature": 0.0, "avg_logprob": -0.24493335794519494, "compression_ratio": 1.4744186046511627, "no_speech_prob": 0.014484303072094917}, {"id": 14, "seek": 5100, "start": 59.0, "end": 62.0, "text": " No, pero antes me estaba olvidando su dispositivo que está.", "tokens": [50764, 883, 11, 4768, 11014, 385, 17544, 43194, 1806, 459, 34769, 6340, 631, 3192, 13, 50914], "temperature": 0.0, "avg_logprob": -0.24493335794519494, "compression_ratio": 1.4744186046511627, "no_speech_prob": 0.014484303072094917}, {"id": 15, "seek": 5100, "start": 62.0, "end": 64.0, "text": " En una computadora.", "tokens": [50914, 2193, 2002, 2807, 23020, 13, 51014], "temperature": 0.0, "avg_logprob": -0.24493335794519494, "compression_ratio": 1.4744186046511627, "no_speech_prob": 0.014484303072094917}, {"id": 16, "seek": 5100, "start": 64.0, "end": 65.0, "text": " Está en crom, ¿no?", "tokens": [51014, 27304, 465, 941, 298, 11, 3841, 1771, 30, 51064], "temperature": 0.0, "avg_logprob": -0.24493335794519494, "compression_ratio": 1.4744186046511627, "no_speech_prob": 0.014484303072094917}, {"id": 17, "seek": 5100, "start": 65.0, "end": 66.0, "text": " Sí, en crom.", "tokens": [51064, 12375, 